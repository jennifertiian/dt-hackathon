# Copy to .env. Never commit .env or paste keys into source files.
CHATGPT_API_KEY=
# Optional: enables server-side Glasser Spotify search (uses Glasser credits).
GLASSER_API_KEY=
PORT=3000
# Saved Google sign-in plus an unsaved mock; organization directory UI stays hidden.
AUTH_MODE=mixed
# Immediate demo cohorts and canned replies. Set 0 for normal next-midnight enrollment.
DEMO_MODE=1
# Leave blank to generate an initial local admin password in data/admin-login.json.
ADMIN_USERNAME=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Main app Google callback: http://localhost:3000/auth/google/callback
# Directory utility callback: http://127.0.0.1:8878/oauth/callback
